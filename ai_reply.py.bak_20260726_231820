@dataclass
class ProviderConfig:
    name: str
    base_url: str
    api_key: str
    text_model: str = ""
    vision_model: str = ""          # 多模态（看图）模型；为空则不支持图片
    temperature: float = 0.85
    max_tokens: int = 200
    timeout_seconds: int = 30
    is_primary: bool = False


@dataclass
class FriendConfig:
    name: str
    enabled: bool = True
    system_prompt: str = ""
    reply_probability: float = 1.0
    min_reply_interval_seconds: int = 60
    active_hours: str = "00:00-23:59"
    max_reply_chars: int = 60
    enable_vision: bool = True       # 是否把对方发的图片/视频截图送模型识别
    enable_emotion: bool = True      # 是否做情绪识别（影响拟人化延迟）
    emotion_tone: bool = True        # 是否把情绪语气微调 + 暖心 emoji 追加进回复；
                                      # 冷人设好友设 False，避免“温暖共情”覆盖“极简冷淡”
    video_comment_reply: bool = False  # 朋友分享视频时：打开视频、从评论区复制一条发给朋友（不用 AI）


@dataclass
class AppConfig:
    providers: list[ProviderConfig] = field(default_factory=list)
    friends: dict[str, FriendConfig] = field(default_factory=dict)
    global_rules: list[str] = field(default_factory=list)
    emotion_on: bool = True
    max_history_messages: int = 20

    @classmethod
    def from_json(cls, raw: dict[str, Any]) -> "AppConfig":
        provs: list[ProviderConfig] = []
        for p in raw.get("providers", []):
            provs.append(ProviderConfig(
                name=p.get("name", "unnamed"),
                base_url=p.get("base_url", ""),
                api_key=p.get("api_key", ""),
                text_model=p.get("text_model", ""),
                vision_model=p.get("vision_model", ""),
                temperature=float(p.get("temperature", 0.85)),
                max_tokens=int(p.get("max_tokens", 200)),
                timeout_seconds=int(p.get("timeout_seconds", 30)),
                is_primary=bool(p.get("is_primary", False)),
            ))
        friends: dict[str, FriendConfig] = {}
        for name, f in raw.get("friends", {}).items():
            friends[name] = FriendConfig(
                name=name,
                enabled=bool(f.get("enabled", True)),
                system_prompt=str(f.get("system_prompt", "")),
                reply_probability=float(f.get("reply_probability", 1.0)),
                min_reply_interval_seconds=int(f.get("min_reply_interval_seconds", 60)),
                active_hours=str(f.get("active_hours", "00:00-23:59")),
                max_reply_chars=int(f.get("max_reply_chars", 60)),
                enable_vision=bool(f.get("enable_vision", True)),
                enable_emotion=bool(f.get("enable_emotion", True)),
                emotion_tone=bool(f.get("emotion_tone", True)),
                video_comment_reply=bool(f.get("video_comment_reply", False)),
            )
        return cls(
            providers=provs,
            friends=friends,
            global_rules=list(raw.get("global_rules", [])),
            emotion_on=bool(raw.get("emotion_on", True)),
            max_history_messages=int(raw.get("max_history_messages", 20)),
        )


# ===================== 日志 =====================

def _log(msg: str) -> None:
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    try:
        with LOG_FILE.open("a", encoding="utf-8") as fp:
            fp.write(line + "\n")
    except Exception:
        pass


