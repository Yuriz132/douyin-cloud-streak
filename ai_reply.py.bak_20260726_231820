def _scan_share_cards_by_id(page: Page, vw: int, conv_left, input_y, seen_text: set) -> list[dict[str, Any]]:
    """扫描【会话面板内】带视频ID属性的元素，作为 SHARE_TITLE_SELS 的兜底，防漏检。
    不依赖 class 名；只取：可见、落在右栏会话面板（排除左栏列表预览）、文案非空 的元素。
    返回 share 消息 dict 列表（含 video_id / video_url / raw）。"""
    out: list[dict[str, Any]] = []
    try:
        data = page.evaluate("""(args) => {
            const [attrs, convLeft, inputY, vw] = args;
            const SEL = attrs.map(a => '[' + a + ']').join(',');
            let els;
            try { els = document.querySelectorAll(SEL); } catch(e) { return []; }
            const res = [];
            for (const el of els) {
                let id = '';
                for (const a of attrs) { const v = el.getAttribute(a); if (v) { id = v; break; } }
                if (!id) continue;
                const r = el.getBoundingClientRect();
                if (r.width <= 0 || r.height <= 0) continue;
                // 与 _in_conv 一致：限定在右侧会话面板
                if (convLeft != null) {
                    if ((r.x + r.width) < convLeft - 20) continue;
                } else if (r.x < vw * 0.29) {
                    continue;
                }
                if (inputY != null && r.y >= inputY - 10) continue;
                let href = '';
                const a = el.closest('a'); if (a) { const h = a.getAttribute('href') || ''; if (h) href = h; }
                if (!href) { const h = el.getAttribute('href') || ''; if (h) href = h; }
                const t = (el.innerText || '').replace(/\\s+/g, ' ').trim();
                res.push({ id: id, href: href, text: t, x: r.x, y: r.y, w: r.width, h: r.height });
            }
            return res;
        }""", [SHARE_ID_ATTRS, conv_left, input_y, vw])
    except Exception:
        return out
    for d in (data or []):
        norm = re.sub(r"\s+", " ", (d.get("text") or "")).strip()
        if not norm:
            continue
        # 分享卡标题可能已被普通文本扫描收录：升级那条消息为分享卡，避免漏检/重复
        if norm in seen_text:
            _upgrade_to_share(out, norm, (d.get("href") or ""), d.get("id", ""))
            continue
        href = (d.get("href") or "")
        if href and not href.startswith("http"):
            href = "https://www.douyin.com" + href
        box = {"x": d.get("x", 0), "y": d.get("y", 0), "width": d.get("w", 0), "height": d.get("h", 0)}
        role = _role_by_box(box, vw)
        out.append({"role": role, "type": "text",
                    "content": f"[分享视频文案] {norm}", "img_b64": None,
                    "raw": norm, "is_share_caption": True,
                    "video_url": href, "video_id": d.get("id", "")})
        seen_text.add(norm)
    return out


def _upgrade_to_share(out: list[dict[str, Any]], norm: str, video_url: str, video_id: str) -> bool:
    """分享卡标题本身也是普通文本节点，可能已被“文字气泡”扫描先收录（norm∈seen_text）。
    此时不丢弃，而是把那条已存在的消息升级为分享卡（补 is_share_caption/url/id），
    既防漏检，又避免重复计数。"""
    for m in out:
        if m.get("raw") == norm and not m.get("is_share_caption"):
            m["is_share_caption"] = True
            if video_url:
                m["video_url"] = video_url
            if video_id:
                m["video_id"] = video_id
            return True
    return False


def _role_by_box(box: dict | None, vw: int) -> str:
    """按消息气泡的横向中心位置判断归属：右半边(>视口60%)是我发的，左半边是对方的。"""
    if not box:
        return "user"
    x_center = box.get("x", 0) + box.get("width", 0) / 2
    return "assistant" if x_center > vw * 0.6 else "user"


def read_recent_messages(page: Page, max_n: int = 60, with_images: bool = True) -> list[dict[str, Any]]:
    """
    返回消息列表，每条：
      { role: 'user'|'assistant', type: 'text'|'image'|'video',
        content: str, img_b64: Optional[str], raw: str }
    关键修复：文字 / 图片 / 视频 / 分享卡片文案 全部按各自 bounding_box.y 排序，
    保证“时间序”正确——否则图片/视频被追加到列表末尾会破坏“最后一条是否我发的”
    判断，导致「对方没回就别回」的开关失效。
    """
    out: list[dict[str, Any]] = []

    # 视口宽度（用于按“左右位置”判断消息归属）
    vw = 1280
    try:
        vs = page.viewport_size
        if vs and vs.get("width"):
            vw = vs["width"]
    except Exception:
        pass

    # 会话面板横向范围：用底部的消息输入框定位【左边界】（排除左侧会话列表里的群名 /
    # 最近消息预览）。右侧边界用视口右边缘——消息气泡可贴到右边，而输入框宽度因内边距
    # 偏窄，不能用它算右边界（否则会把“我发的右侧气泡”误判为面板外而丢掉，
    # 导致「最后一条是我发的就跳过」永远失效）。
    conv_left = input_y = None
    try:
        ib = page.locator(SEL_MESSAGE_INPUT).first.bounding_box()
        if ib:
            conv_left = ib.get("x", 0)
            input_y = ib.get("y", 0)
    except Exception:
        pass

    def _in_conv(box) -> bool:
        """该文本/元素是否落在右侧会话面板内（而非左侧会话列表/底部贴纸/输入栏）。"""
        if not box:
            return True  # 无坐标则保守放行
        x = box.get("x", 0)
        w = box.get("width", 0)
        y = box.get("y", 0)
        # 左侧：排除完全在面板左侧之外的元素（左侧栏群名/最近消息）
        if conv_left is not None:
            if x + w < conv_left - 20:
                return False
        else:
            # 兜底：排除明显在左栏的（<视口29%）
            if x < vw * 0.29:
                return False
        # 底部：排除输入行本身（贴纸面板由 UI_NOISE_TEXTS 兜底）
        if input_y is not None and y >= input_y - 10:
            return False
        return True

    seen_text: set[str] = set()

    # 1) 文字气泡（含分享卡片里的文案文本，会被 get_by_text 命中）
    #    窗口拉宽到 max_n*4，避免较旧的消息 / 视频文案被截断而读不到。
    text_nodes = page.get_by_text("", exact=False)
    n = text_nodes.count()
    for i in range(max(0, n - max_n * 4), n):
        node = text_nodes.nth(i)
        try:
            txt = (node.inner_text(timeout=1500) or "").strip()
        except Exception:
            continue
        if not txt or len(txt) > 400 or txt in seen_text:
            continue
        # 过滤掉界面噪音（导航/按钮/反爬注入串），避免被误判为好友消息
        if _is_noise_text(txt):
            continue
        # 过滤非消息元素：时间标签、聊天头(好友昵称)、火花标签、已读回执
        cls = (node.get_attribute("class") or "").lower()
        if any(k in cls for k in ("timelayout", "timestr", "header", "streak", "hasread", "readtext")):
            continue
        # 角色判定：抖音把昵称/文本拆成 <span>，且气泡 class 不含 self/right 等关键字，
        # 因此改用“位置”判断——右半边(>视口60%)是我发的，左半边是对方的。
        try:
            box = node.bounding_box()
        except Exception:
            box = None
        # 只保留会话面板内的文本，排除左侧会话列表噪声（群名/最近消息预览等）
        if not _in_conv(box):
            continue
        y = box.get("y", 0) if box else 0
        out.append({"role": _role_by_box(box, vw), "type": "text",
                    "content": txt, "img_b64": None, "raw": txt, "_y": y})
        seen_text.add(txt)

    # 2) 专门抓取“分享的视频的文案”（标题/文案）。
    #    抖音分享卡片的标题是 <span> 文本，但可能被 get_by_text 窗口淹没，这里兜底确保 AI 能看到。
    #    分享卡扫描【不依赖】with_images（视觉开关）——视频评论功能需要它，
    #    即使关闭视觉也应能识别朋友分享的视频，故始终执行。
    if with_images or True:
        for sel in SHARE_TITLE_SELS:
            try:
                nodes = page.locator(sel)
                cnt = nodes.count()
            except Exception:
                continue
            for k in range(cnt):
                try:
                    txt = (nodes.nth(k).inner_text(timeout=1500) or "").strip()
                except Exception:
                    continue
                # 抖音把分享文案拆成多行 <span>，inner_text 带换行 -> 归一化后再去重/存储
                norm = re.sub(r"\s+", " ", txt).strip()
                if not norm:
                    continue
                # 分享卡标题本身也是普通文本节点，可能已被“文字气泡”扫描先收录。
                # 此时不丢弃，而是把那条消息升级为分享卡（补 is_share_caption/url/id），防漏检。
                if norm in seen_text:
                    # 先尝试抓该卡的 video_url / video_id，再升级
                    video_url = ""; video_id = ""
                    try:
                        res = nodes.nth(k).evaluate("""el => {
                            const ks=['data-aweme-id','data-vid','data-aid','data-item-id','data-eid','data-aweme_id','data-video-id'];
                            let ids=[], href='';
                            el.querySelectorAll('*').forEach(x=>{ ks.forEach(kk=>{let v=x.getAttribute(kk); if(v) ids.push(v);}); });
                            let a=el.closest('a'); if(a){ let h=a.getAttribute('href')||''; if(h) href=h; }
                            if(!href){ let h=el.getAttribute('href')||''; if(h) href=h; }
                            let p=el.parentElement; for(let i=0;i<8 && p;i++){ ks.forEach(kk=>{let v=p.getAttribute(kk); if(v) ids.push(v);}); p=p.parentElement; }
                            return {href:href, id: ids[0]||''};
                        }""")
                        href = (res.get("href", "") or "") if isinstance(res, dict) else ""
                        if href and not href.startswith("http"):
                            href = "https://www.douyin.com" + href
                        video_url = href
                        video_id = (res.get("id", "") or "") if isinstance(res, dict) else ""
                    except Exception:
                        video_url = ""; video_id = ""
                    _upgrade_to_share(out, norm, video_url, video_id)
                    continue
                try:
                    box = nodes.nth(k).bounding_box()
                except Exception:
                    box = None
                y = box.get("y", 0) if box else 0
                role = _role_by_box(box, vw)
                # 排除落在左侧会话列表里的分享卡片（不是当前会话内容）
                if not _in_conv(box):
                    continue
                # 抓视频链接 / 视频ID：
                # 抖音分享卡通常是 JS 点击跳转（无 href），所以优先从子树/祖先里找
                # data-aweme-id / data-vid / data-aid / data-item-id 等，用来构造
                # https://www.douyin.com/video/{id}；同时兜底尝试 href。
                video_url = ""; video_id = ""
                try:
                    res = nodes.nth(k).evaluate("""el => {
                        const ks=['data-aweme-id','data-vid','data-aid','data-item-id','data-eid','data-aweme_id','data-video-id'];
                        let ids=[], href='';
                        el.querySelectorAll('*').forEach(x=>{ ks.forEach(kk=>{let v=x.getAttribute(kk); if(v) ids.push(v);}); });
                        let a=el.closest('a'); if(a){ let h=a.getAttribute('href')||''; if(h) href=h; }
                        if(!href){ let h=el.getAttribute('href')||''; if(h) href=h; }
                        let p=el.parentElement; for(let i=0;i<8 && p;i++){ ks.forEach(kk=>{let v=p.getAttribute(kk); if(v) ids.push(v);}); p=p.parentElement; }
                        return {href:href, id: ids[0]||''};
                    }""")
                    href = (res.get("href", "") or "") if isinstance(res, dict) else ""
                    if href and not href.startswith("http"):
                        href = "https://www.douyin.com" + href
                    video_url = href
                    video_id = (res.get("id", "") or "") if isinstance(res, dict) else ""
                except Exception:
                    video_url = ""; video_id = ""
                out.append({"role": role, "type": "text",
                            "content": f"[分享视频文案] {norm}", "img_b64": None,
                            "raw": norm, "_y": y, "is_share_caption": True,
                            "video_url": video_url, "video_id": video_id})
                seen_text.add(norm)

    # 2b) 更稳兜底：直接扫描会话面板内带视频ID属性的元素（不依赖 class 名，防漏检）
    if with_images or True:  # 分享卡扫描始终执行（同上，不依赖视觉开关）
        try:
            id_shares = _scan_share_cards_by_id(page, vw, conv_left, input_y, seen_text)
            out.extend(id_shares)
        except Exception:
            pass

    # 3) 图片/视频元素（截图给多模态模型看），记录 y 以便按时间排序
    if with_images:
        for sel in ['img[src*="png"]', 'img[src*="jpeg"]', 'img[src*="jpg"]',
                    'video', 'img[class*="image"]', 'img[class*="thumb"]']:
            elems = page.locator(sel)
            cnt = min(elems.count(), 6)
            for j in range(cnt):
                el = elems.nth(j)
                b64 = _element_png_b64(el)
                if not b64:
                    continue
                try:
                    ib = el.bounding_box()
                except Exception:
                    ib = None
                # 头像/小图标通常 < 60px，跳过；否则按左右位置判断归属
                if ib and (ib.get("width", 0) < 60 or ib.get("height", 0) < 60):
                    continue
                # 只保留会话面板内的图片/视频，排除左侧列表头像/缩略图
                if not _in_conv(ib):
                    continue
                tag = "video" if sel == "video" else "image"
                y = ib.get("y", 0) if ib else 0
                out.append({"role": _role_by_box(ib, vw), "type": tag,
                            "content": f"[{tag}]", "img_b64": b64, "raw": f"[{tag}]", "_y": y})

    # 4) 全部按页面纵向位置排序（=时间先后），再去掉临时字段，并按 (role,type,content) 去重
    out.sort(key=lambda m: m.get("_y", 0))
    for m in out:
        m.pop("_y", None)
    deduped: list[dict[str, Any]] = []
    seen_key: set[tuple] = set()
    for m in out:
        key = (m["role"], m["type"], m["content"])
        if key in seen_key:
            continue
        seen_key.add(key)
        deduped.append(m)
    return deduped[-max_n:]


def send_text(page: Page, text: str) -> bool:
    if not text.strip():
        return False
    try:
        editor = page.locator(SEL_MESSAGE_INPUT).first
        editor.wait_for(timeout=10000)
        editor.click()
        time.sleep(random.uniform(0.2, 0.6))
        chunk = random.randint(6, 12)
        for i in range(0, len(text), chunk):
            editor.type(text[i:i + chunk], delay=random.randint(30, 80))
        time.sleep(random.uniform(0.3, 0.7))
        sb = page.locator('button[aria-label*="发送" i], div[aria-label*="发送" i]').first
        if sb.count() > 0 and sb.is_enabled():
            sb.click()
        else:
            editor.press("Enter")
        time.sleep(random.uniform(0.8, 1.5))
        return True
    except Exception as e:
        _log(f"[发送] 失败: {e}")
        return False


# ===================== 分享视频 -> 复制评论回复（不用 AI）=====================

def scrape_video_comments(root, max_n: int = 60) -> list[str]:
    """从抖音视频页/分享弹窗的评论区抓评论文本。
    root 可为 Page 或弹窗 ElementHandle/Locator：传入弹窗元素即可只抓弹窗内评论，
    避免把聊天里的分享卡（class 含 CommentShare）误当评论。
    尽力而为：优先评论区常见 class，失败则广扫面板文本。"""
    cands: list[str] = []
    for sel in ('[class*="comment"]', '[class*="Comment"]',
                '[class*="reply"]', '[class*="Reply"]',
                '[class*="noteText"]', '[class*="NoteText"]',
                '[class*="Cmt"]', '[class*="cmt"]',
                '[class*="listItem"]', '[class*="ListItem"]'):
        try:
            nodes = root.locator(sel)
            n = min(nodes.count(), max_n)
            for i in range(n):
                try:
                    t = (nodes.nth(i).inner_text(timeout=1200) or "").strip()
                except Exception:
                    continue
                t = re.sub(r"\s+", " ", t).strip()
                if 3 <= len(t) <= 50 and not _is_noise_text(t):
                    cands.append(t)
        except Exception:
            continue
    # 兜底：class 选择器没命中时，按 root 类型广扫文本
    if len(cands) < 3:
        if hasattr(root, "get_by_text"):  # Page：整页 get_by_text 兜底
            try:
                nodes = root.get_by_text("", exact=False)
                for i in range(max(0, nodes.count() - 300), nodes.count()):
                    try:
                        t = (nodes.nth(i).inner_text(timeout=1000) or "").strip()
                    except Exception:
                        continue
                    t = re.sub(r"\s+", " ", t).strip()
                    if 3 <= len(t) <= 40 and not _is_noise_text(t):
                        cands.append(t)
            except Exception:
                pass
        else:  # 弹窗 ElementHandle：JS 遍历子树文本节点（抗抖音哈希化类名）
            try:
                txts = root.evaluate("""(el) => {
                    const out = [];
                    const walk = (n) => {
                        if (n.nodeType === 3) {
                            const t = (n.textContent || '').replace(/\\s+/g, ' ').trim();
                            if (t.length >= 2 && t.length <= 60) out.push(t);
                        } else {
                            for (const c of n.childNodes) walk(c);
                        }
                    };
                    walk(el);
                    return out;
                }""")
                for t in (txts or []):
                    t = re.sub(r"\s+", " ", t).strip()
                    if 3 <= len(t) <= 50 and not _is_noise_text(t):
                        cands.append(t)
            except Exception:
                pass
    # 去重 + 轻度过滤（排除时间/“回复”/链接/广告词）
    seen: set[str] = set()
    out: list[str] = []
    for t in cands:
        if t in seen:
            continue
        seen.add(t)
        low = t.lower()
        if any(b in low for b in ("http", ".com", ".cn", "加微信", "私聊", "下单", "点击", "关注", "展开")):
            continue
        if re.search(r"(分钟前|小时前|天前|刚刚|回复|@|万赞|万赞)", t):
            continue
        out.append(t)
    return out


def _locate_share_card(page: Page, share_msg: dict[str, Any]):
    """在当前聊天页定位分享卡元素。优先按 video_id 精确定位（最稳），
    其次按文案匹配，最后兜底返回最后一个带 video_id 的元素 / 分享卡。"""
    raw = (share_msg.get("raw", "") or "").strip()
    vid = (share_msg.get("video_id", "") or "").strip()
    # ① 优先按 video_id 精确定位
    if vid:
        for attr in SHARE_ID_ATTRS:
            try:
                nodes = page.locator(f'[{attr}="{vid}"]')
                if nodes.count() > 0:
                    return nodes.first
            except Exception:
                continue
    # ② 按文案匹配（原逻辑）
    for sel in SHARE_TITLE_SELS:
        try:
            nodes = page.locator(sel)
            c = nodes.count()
        except Exception:
            continue
        for i in range(c):
            try:
                t = (nodes.nth(i).inner_text(timeout=1200) or "")
            except Exception:
                continue
            t = re.sub(r"\s+", " ", t).strip()
            if raw and (raw in t or t in raw):
                return nodes.nth(i)
    # ③ 兜底：最后一个带 video_id 的元素；再不行返回最后一个 SHARE_TITLE_SELS 元素
    try:
        for attr in SHARE_ID_ATTRS:
            nodes = page.locator(f'[{attr}]')
            if nodes.count() > 0:
                return nodes.nth(nodes.count() - 1)
    except Exception:
        pass
    try:
        nodes = page.locator(SHARE_TITLE_SELS[0])
        if nodes.count() > 0:
            return nodes.nth(nodes.count() - 1)
    except Exception:
        pass
    return None


def _find_video_modal(page: Page):
    """抖音分享卡点击后常在【同页全屏弹窗】里播放视频（URL 不变、无新标签）。
    返回该弹窗的 ElementHandle（若可见），否则 None。"""
    try:
        h = page.evaluate_handle("""() => {
            const all = document.querySelectorAll('*');
            for (const el of all) {
                const c = (el.getAttribute('class') || '').toLowerCase();
                if (c.includes('commonmodalfullscreen') || (c.includes('xgplayer') && c.includes('playing'))) {
                    const r = el.getBoundingClientRect();
                    if (r.width > 400 && r.height > 400) return el;
                }
            }
            return null;
        }""")
        return h.as_element() if h else None
    except Exception:
        return None


def _click_share_card_and_wait(page: Page, share_msg: dict[str, Any], timeout: int = 25):
    """点击分享卡等待“视频打开”。返回 (ok, popup_page, modal_el)：
    - 本标签跳转到 /video/  -> (True, None, None)
    - 新标签弹出            -> (True, popup_page, None)
    - 同页全屏弹窗（最常见）-> (True, None, modal_el)，URL 不变、无新标签
    modal_el 用于后续只在弹窗作用域内抓评论，避免误抓聊天里的分享卡。"""
    el = _locate_share_card(page, share_msg)
    if el is None:
        _log("[视频] 找不到分享卡元素，无法点击")
        return False, None, None
    popups: list = []
    page.on("popup", lambda p: popups.append(p))
    try:
        el.click(force=True, timeout=6000)
    except Exception as e:
        _log(f"[视频] 点击分享卡失败: {e}")
        return False, None, None
    waited = 0
    while waited < timeout:
        if "/video/" in page.url:
            return True, None, None
        if popups:
            try:
                popups[0].wait_for_load_state("domcontentloaded", timeout=8000)
            except Exception:
                pass
            return True, popups[0], None
        mh = _find_video_modal(page)
        modal = mh.as_element() if mh else None
        if modal is not None:
            return True, None, modal
        time.sleep(1); waited += 1
    # 超时兜底再判断一次
    if "/video/" in page.url:
        return True, None, None
    if popups:
        try:
            popups[0].wait_for_load_state("domcontentloaded", timeout=8000)
        except Exception:
            pass
        return True, popups[0], None
    mh = _find_video_modal(page); modal = mh.as_element() if mh else None
    if modal is not None:
        return True, None, modal
    return False, None, None


def open_shared_video_and_get_comment(page: Page, share_msg: dict[str, Any]):
    """打开朋友分享的视频，等评论加载，随机返回一条评论；返回 (comment, info)。
    info 记录实际使用的打开策略（video_id / video_url / click）与最终落点 URL，便于诊断。
    三种策略：① 用分享卡里的 video_id 构造 /video/{id}；② 用 video_url 直跳；③ 点击分享卡观察跳转。
    """
    info: dict[str, Any] = {"strategy": "", "landed_url": ""}
    vid = (share_msg.get("video_id", "") or "").strip()
    url = (share_msg.get("video_url", "") or "").strip()
    target = None
    modal = None
    popup = None
    if vid:
        target = f"https://www.douyin.com/video/{vid}"
        info["strategy"] = "video_id"
    elif url:
        target = url
        info["strategy"] = "video_url"
    if target:
        try:
            page.goto(target, wait_until="domcontentloaded", timeout=30000)
            _log(f"[视频] 用 {info['strategy']} 打开: {target}")
        except Exception as e:
            _log(f"[视频] {info['strategy']} 打开失败: {e}，回退点击")
            target = None
    if not target:
        info["strategy"] = "click"
        _log("[视频] 尝试点击分享卡打开...")
        ok, popup, modal = _click_share_card_and_wait(page, share_msg)
        if not ok:
            info["landed_url"] = page.url
            _log(f"[视频] 点击后未跳转到视频页/弹窗，当前 URL: {page.url}")
            return None, info
        # 新标签弹出 -> 用 popup 抓评论；同页弹窗 -> 用 modal 元素作作用域（只抓弹窗内）；
        # 本标签跳转 -> 用 page。
        if popup is not None:
            view_root = popup
            info["landed_url"] = popup.url
        elif modal is not None:
            view_root = modal
            info["landed_url"] = page.url
        else:
            view_root = page
            info["landed_url"] = page.url
        info["modal"] = modal is not None
    else:
        view_root = page
        info["landed_url"] = page.url
    # 视频页/弹窗比私信页慢，多等；滚动触发评论懒加载
    time.sleep(10)
    try:
        page.mouse.wheel(0, 600)
    except Exception:
        pass
    time.sleep(4)
    comments = scrape_video_comments(view_root)
    if not comments:
        _log("[视频] 未抓到任何评论（策略=%s，modal=%s）" % (info["strategy"], info.get("modal")))
        # 若是弹窗/新标签，先关掉，避免卡住后续流程
        if modal is not None:
            try: page.keyboard.press("Escape"); time.sleep(2)
            except Exception: pass
        if popup is not None:
            try: popup.close()
            except Exception: pass
        return None, info
    _log(f"[视频] 抓到 {len(comments)} 条评论，随机选 1 条（策略={info['strategy']}，modal={info.get('modal')}）")
    _log("[视频] 评论样本: " + " | ".join(comments[:8]))
    chosen = random.choice(comments)
    # 关弹窗/关新标签，回到聊天页（return_to_chat_and_open 会导航，但先关更稳）
    if modal is not None:
        try: page.keyboard.press("Escape"); time.sleep(2)
        except Exception: pass
    if popup is not None:
        try: popup.close()
        except Exception: pass
    return chosen, info


def return_to_chat_and_open(page: Page, friend: "FriendConfig") -> bool:
    """从视频页返回私信页并重新打开该好友会话，准备发送。"""
    try:
        goto_messages(page)
    except Exception as e:
        _log(f"[视频] 返回私信页失败: {e}")
        return False
    if not open_friend_chat(page, friend.name):
        _log(f"[视频] 重新打开 {friend.name} 会话失败")
        return False
    return True


def handle_shared_video_comment(page: Page, cfg: "AppConfig", friend: "FriendConfig",
                                share_msg: dict[str, Any], *, dry_run: bool) -> dict[str, Any]:
    """朋友分享视频：打开视频、从评论区复制一条、当回复发给朋友（不使用 AI）。"""
    result = {"friend": friend.name, "new": 1, "replied": False, "skipped": ""}
    caption = share_msg.get("raw", "")
    vid = share_msg.get("video_id", "")
    url = share_msg.get("video_url", "")
    _log(f"[{friend.name}] 检测到分享视频（文案：{caption[:30]}；video_id={vid!r}；video_url={url!r}），走「复制评论」流程（不用 AI）")
    comment, info = open_shared_video_and_get_comment(page, share_msg)
    result["strategy"] = info.get("strategy", "")
    result["landed_url"] = info.get("landed_url", "")
    if not comment:
        _log(f"[{friend.name}] 没取到评论，跳过（不调用 AI）。策略={info.get('strategy')}")
        result["skipped"] = "video_comment_empty"
        return result
    # 回到私信页并重新打开会话，再发送
    if not return_to_chat_and_open(page, friend):
        result["skipped"] = "return_to_chat_failed"
        return result
    _log(f"[{friend.name}] 将发送视频评论: {comment}")
    if dry_run:
        result["replied"] = "DRY-RUN"
        result["sent"] = comment
        return result
    delay = humanized_delay("neutral", len(comment))
    _log(f"[{friend.name}] 拟人化延迟 {delay:.0f}s 后发送")
    time.sleep(delay)
    if send_text(page, comment):
        now = time.time()
        history = load_history(friend.name)
        history.append({"role": "user", "content": f"[视频评论] {caption}", "ts": now})
        history.append({"role": "assistant", "content": comment, "ts": now, "video_comment": True})
        save_history(friend.name, history)
        result["replied"] = True
    else:
        result["skipped"] = "send_failed"
    return result


# ===================== 拟人化延迟 =====================

def humanized_delay(emotion: str, msg_len: int) -> float:
    lo, hi = EMOTION_DELAY.get(emotion, (15, 70))
    base = random.uniform(lo, hi)
    # 消息越长，思考越久（每 20 字 +3~8s）
    base += (msg_len // 20) * random.uniform(3, 8)
    # 深夜/清晨更慢（像在玩手机偶尔回）
    h = datetime.now().hour
    if h < 7 or h >= 23:
        base *= 1.4
    return min(base, 240)  # 上限 4 分钟


# ===================== 处理单个好友 =====================

def process_friend(page: Page, cfg: AppConfig, friend: FriendConfig, *, dry_run: bool) -> dict[str, Any]:
    result = {"friend": friend.name, "new": 0, "replied": False, "skipped": ""}
    if not friend.enabled:
        result["skipped"] = "disabled"; return result
    if not in_active_hours(friend.active_hours):
        result["skipped"] = f"outside({friend.active_hours})"; return result

    history = load_history(friend.name)
    last_reply = next((h.get("ts") for h in reversed(history) if h.get("role") == "assistant"), 0)
    if last_reply:
        gap = time.time() - float(last_reply)
        if gap < friend.min_reply_interval_seconds:
            result["skipped"] = f"min_interval({int(gap)}s<{friend.min_reply_interval_seconds}s)"
            return result

    if not open_friend_chat(page, friend.name):
        result["skipped"] = "chat_open_failed"; return result

    msgs = read_recent_messages(page, with_images=friend.enable_vision)
    if not msgs:
        result["skipped"] = "empty_chat"; return result
    # 找最近一条"我发的"，其后的对方消息即新消息
    last_mine = -1
    for i, m in enumerate(msgs):
        if m["role"] == "assistant":
            last_mine = i
    incoming = [m for m in msgs[last_mine + 1:] if m["role"] == "user"]
    # 额外保险：若整段最后一条仍是我发的，说明对方尚未回复 / 没分享 -> 不回、不调 AI
    if msgs[-1]["role"] == "assistant":
        _log(f"[{friend.name}] 最后一条是我发的，对方无新消息，跳过（不调用 AI）")
        result["skipped"] = "last_is_mine(no_reply_from_friend)"; return result
    if not incoming:
        result["skipped"] = "no_new_incoming(对方无新消息)"; return result

    # 分享视频 -> 走「复制评论」流程（不用 AI）；抓不到链接则自动跳过，不会回退到 AI
    if friend.video_comment_reply:
        share_msgs = [m for m in incoming if m.get("is_share_caption")]
        if share_msgs:
            return handle_shared_video_comment(page, cfg, friend, share_msgs[-1], dry_run=dry_run)

    result["new"] = len(incoming)
    text_incoming = [m["content"] for m in incoming if m["type"] == "text" and m["content"].strip()]
    img_incoming = [m["img_b64"] for m in incoming if m.get("img_b64")]
    merged_text = "\n".join(text_incoming)
    _log(f"[{friend.name}] 收到 {len(incoming)} 条新消息(含图 {len(img_incoming)}): "
         + " | ".join(c[:30] for c in text_incoming))

    if random.random() > friend.reply_probability:
        result["skipped"] = "random_skip"; return result

    # 情绪识别
    emotion = "neutral"
    if cfg.emotion_on and friend.enable_emotion and merged_text:
        emotion = detect_emotion(cfg, merged_text)
        _log(f"[{friend.name}] 情绪: {EMOTION_CN.get(emotion, emotion)}")

    extra_system = ""
    if cfg.emotion_on and friend.emotion_tone:
        extra_system += "\n" + EMOTION_TONE.get(emotion, "")

    # 组成本轮要喂给模型的文本上下文
    context_lines = []
    for m in incoming:
        if m.get("is_share_caption"):
            cap = m["content"].replace("[分享视频文案] ", "", 1)
            context_lines.append(f"对方分享了一个视频，文案是：{cap}")
        elif m["type"] == "text":
            context_lines.append(f"对方：{m['content']}")
        else:
            context_lines.append(f"对方发来一张{m['type']}（需要看图片理解）")
    prompt_text = "\n".join(context_lines)
    if not prompt_text.strip():
        result["skipped"] = "empty"; return result

    # 多模态：把图片送给 vision 模型先"看懂"
    vision_desc = ""
    if friend.enable_vision and img_incoming:
        vision_desc = chat_vision(
            cfg, friend,
            "用一句话描述这张私信里的图片/截图在说什么（如果有文字/表情包，请读出文字）。",
            img_incoming, extra_system,
        ) or ""
        if vision_desc:
            _log(f"[{friend.name}] 图片理解: {vision_desc[:60]}")
            prompt_text += f"\n（对方图片内容：{vision_desc}）"

    reply = chat_text(cfg, friend, [{"role": "user", "content": prompt_text}], extra_system)
    if not reply:
        result["skipped"] = "ai_returned_empty"; return result

    # 长度裁剪 + 防暴露 AI 身份
    if len(reply) > friend.max_reply_chars:
        reply = reply[:friend.max_reply_chars].rstrip("，。！？,.!? ") + "…"
    reply = re.sub(r"作为\s*(一个|一款)?\s*AI|我是\s*AI|人工智能", "我", reply, flags=re.IGNORECASE)

    # 拟人化 emoji（按情绪加点表情文字）；冷人设好友不追加暖心 emoji
    if friend.emotion_tone:
        if emotion in ("happy", "teasing") and random.random() < 0.5:
            reply = reply.rstrip() + random.choice(["😄", "哈哈", "[捂脸]", "[旺柴]"])
        elif emotion in ("sad", "need_care") and random.random() < 0.4:
            reply = reply.rstrip() + random.choice(["🥺", "[抱抱]", "😢"])

    _log(f"[{friend.name}] AI 拟回复: {reply}")

    if dry_run:
        result["replied"] = "DRY-RUN"; return result

    # 拟人化延迟后再发
    delay = humanized_delay(emotion, len(merged_text))
    _log(f"[{friend.name}] 拟人化延迟 {delay:.0f}s 后发送")
    time.sleep(delay)

    if send_text(page, reply):
        now = time.time()
        for m in incoming:
            history.append({"role": "user", "content": m["content"], "ts": now})
        history.append({"role": "assistant", "content": reply, "ts": now,
                        "emotion": emotion})
        save_history(friend.name, history)
        result["replied"] = True
    else:
        result["skipped"] = "send_failed"
    return result


# ===================== 主入口 =====================

def run(*, dry_run: bool = False, only_friend: str | None = None) -> int:
    try:
        cfg = load_config()
    except Exception as e:
        _log(f"[启动] 配置读取失败: {e}"); return 2
    if not cfg.providers or all(not p.api_key for p in cfg.providers):
        _log("[启动] 没有任何 provider 配置了有效 api_key"); return 2

    targets = list(cfg.friends.values())
    if only_friend:
        targets = [f for f in targets if f.name == only_friend]
        if not targets:
            _log(f"[启动] 没找到好友 {only_friend}"); return 0

    with sync_playwright() as pw:
        try:
            ctx = build_context(pw)
        except Exception as e:
            _log(f"[启动] 浏览器初始化失败: {e}"); return 3
        page = ctx.new_page()
        try:
            goto_messages(page)
        except Exception as e:
            _log(f"[启动] 进入私信页失败: {e}"); ctx.close(); return 3

        for f in targets:
            try:
                r = process_friend(page, cfg, f, dry_run=dry_run)
                _log(f"[摘要] {r}")
                time.sleep(random.uniform(1.5, 3.5))
            except Exception as e:
                _log(f"[异常] 处理 {f.name}: {e}")
        ctx.close()
    _log("[本轮完成]")
    return 0


def show_stats() -> None:
    HISTORY_DIR.mkdir(parents=True, exist_ok=True)
    rows = []
    for fp in HISTORY_DIR.glob("*.json"):
        try:
            data = json.loads(fp.read_text(encoding="utf-8"))
        except Exception:
            continue
        n = len(data)
        last = data[-1].get("ts", 0) if n else 0
        last_str = datetime.fromtimestamp(last).strftime("%Y-%m-%d %H:%M") if last else "-"
        rows.append((fp.stem, n, last_str))
    rows.sort(key=lambda x: x[2], reverse=True)
    print(f"{'好友':<22} {'条数':>6}  {'最后一条'}")
    print("-" * 46)
    for name, n, last in rows:
        print(f"{name:<22} {n:>6}  {last}")
    if not rows:
        print("暂无历史")


def main() -> None:
    p = argparse.ArgumentParser(description="抖音私信 AI 自动回复（多模态版）")
    p.add_argument("--once", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--friend", type=str, default=None)
    p.add_argument("--stats", action="store_true")
    args = p.parse_args()
    if args.stats:
        show_stats(); return
    sys.exit(run(dry_run=args.dry_run, only_friend=args.friend))


if __name__ == "__main__":
    main()
