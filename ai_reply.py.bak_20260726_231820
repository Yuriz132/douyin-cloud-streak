def load_config() -> AppConfig:
    if not AI_CONFIG_FILE.exists():
        raise FileNotFoundError("找不到 ai_config.json，请先创建（参考 ai_config.example.json）。")
    return AppConfig.from_json(json.loads(AI_CONFIG_FILE.read_text(encoding="utf-8")))


def load_history(friend_name: str) -> list[dict[str, Any]]:
    safe = re.sub(r"[\\/:*?\"<>|]", "_", friend_name)
    p = HISTORY_DIR / f"{safe}.json"
    if not p.exists():
        return []
    try:
        return json.loads(p.read_text(encoding="utf-8")) or []
    except Exception as e:
        _log(f"[历史] 读取 {friend_name} 失败: {e}")
        return []


def save_history(friend_name: str, history: list[dict[str, Any]]) -> None:
    HISTORY_DIR.mkdir(parents=True, exist_ok=True)
    safe = re.sub(r"[\\/:*?\"<>|]", "_", friend_name)
    try:
        (HISTORY_DIR / f"{safe}.json").write_text(
            json.dumps(history, ensure_ascii=False, indent=2), encoding="utf-8"
        )
    except Exception as e:
        _log(f"[历史] 写入 {friend_name} 失败: {e}")


# ===================== 时间 =====================

def in_active_hours(active_hours: str) -> bool:
    try:
        s, e = active_hours.split("-")
        sh, sm = map(int, s.strip().split(":"))
        eh, em = map(int, e.strip().split(":"))
        now = datetime.now().time()
        return dtime(sh, sm) <= now <= dtime(eh, em)
    except Exception:
        return True


# ===================== AI 调用（含 fallback） =====================

def _post(prov: ProviderConfig, messages: list[dict], model: str) -> str | None:
    if not prov.api_key or not prov.base_url:
        return None
    url = prov.base_url.rstrip("/") + "/chat/completions"
    payload = {
        "model": model, "messages": messages,
        "temperature": prov.temperature, "max_tokens": prov.max_tokens, "stream": False,
    }
    headers = {"Authorization": f"Bearer {prov.api_key}", "Content-Type": "application/json"}
    try:
        r = requests.post(url, json=payload, headers=headers, timeout=prov.timeout_seconds)
        r.raise_for_status()
        return r.json().get("choices", [{}])[0].get("message", {}).get("content", "").strip() or None
    except Exception as e:
        _log(f"[AI:{prov.name}] 失败: {e}")
        return None


def chat_text(cfg: AppConfig, friend: FriendConfig, text_messages: list[dict],
              extra_system: str = "") -> str | None:
    """纯文本回复，按 providers 顺序 fallback。返回回复文本或 None。"""
    system_parts = []
    if friend.system_prompt.strip():
        system_parts.append(friend.system_prompt.strip())
    if extra_system:
        system_parts.append(extra_system)
    for rule in cfg.global_rules:
        system_parts.append(f"- {rule}")
    system_parts.append(
        f"输出长度不超过 {friend.max_reply_chars} 字。保持自然口语化，"
        "不分多段，不用列表，不用 markdown。"
    )
    system = "\n\n".join(system_parts)
    msgs: list[dict] = [{"role": "system", "content": system}]
    msgs.extend(text_messages[-cfg.max_history_messages:])
    for prov in cfg.providers:
        if not prov.text_model:
            continue
        reply = _post(prov, msgs, prov.text_model)
        if reply:
            return reply
    return None


def chat_vision(cfg: AppConfig, friend: FriendConfig, text_prompt: str,
                image_b64_list: list[str], extra_system: str = "") -> str | None:
    """多模态（看图）理解，返回文本描述或 None。"""
    system_parts = []
    if friend.system_prompt.strip():
        system_parts.append(friend.system_prompt.strip())
    if extra_system:
        system_parts.append(extra_system)
    system_parts.append("你正在帮对方理解他/她发来的图片/视频截图内容，用一句话概括关键信息即可。")
    system = "\n\n".join(system_parts)
    content: list[dict] = [{"type": "text", "text": text_prompt}]
    for b64 in image_b64_list:
        content.append({"type": "image_url", "image_url": {"url": f"data:image/png;base64,{b64}"}})
    msgs = [{"role": "system", "content": system},
            {"role": "user", "content": content}]
    for prov in cfg.providers:
        if not prov.vision_model:
            continue
        reply = _post(prov, msgs, prov.vision_model)
        if reply:
            return reply
    return None


def detect_emotion(cfg: AppConfig, text: str) -> str:
    """用主文本模型快速分类情绪；失败回 neutral。"""
    if not text.strip():
        return "neutral"
    sys = ("判断下面这条私信对方的情绪，只回一个英文标签："
           + "/".join(EMOTIONS) + "。不要解释。")
    msgs = [{"role": "system", "content": sys},
            {"role": "user", "content": text[-300:]}]
    for prov in cfg.providers:
        if not prov.text_model:
            continue
        lab = _post(prov, msgs, prov.text_model)
        if lab:
            lab = re.sub(r"[^a-z_]", "", lab.lower()).strip()
            return lab if lab in EMOTIONS else "neutral"
    return "neutral"


