[Unit]
Description=Douyin Cloud Streak Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__DIR__
ExecStart=__VENV__/bin/python app.py
Restart=always
RestartSec=5
EnvironmentFile=-__DIR__/.env

# 内存紧张时系统优先回收浏览器子进程而非主服务 (防止整站崩溃)
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target
