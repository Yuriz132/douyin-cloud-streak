    except PWTimeoutError:
        _log("[UI] 页面渲染超时，可能登录态失效或被风控")
        raise


def _js_find_and_click(page: Page, name: str) -> bool:
    """JS 遍历 DOM textContent 找包含 name 的最短元素（对字符拆分免疫），点击后返回 True。"""
    try:
        handle = page.evaluate_handle(f"""(n) => {{
            let best=null,bestLen=1e9; const all=document.querySelectorAll('*');
            for(const el of all){{const r=el.getBoundingClientRect();
                if(r.x>480)continue;
                const t=(el.textContent||'').trim();
                if(t.includes(n)&&t.length>0&&t.length<bestLen){{best=el;bestLen=t.length;}}
            }}return best;
        }}""", name)
        el = handle.as_element() if handle else None
        if el:
            el.click(force=True)
            time.sleep(random.uniform(2, 4))
            return True
    except Exception as e:
        _log(f"[UI] JS 定位 {name} 失败: {e}")
    return False


def search_and_open(page: Page, name: str) -> bool:
    try:
        box = page.get_by_placeholder("搜索", exact=False).first
        if box.count() == 0:
            return False
        box.click()
        box.fill(name)
        time.sleep(5)
        # 搜索结果的匹配同样用 JS（字符拆分免疫）
        if _js_find_and_click(page, name):
            if page.locator('div[contenteditable="true"]').first.count() == 0:
                sb = page.get_by_text("发消息", exact=False).first
                if sb.count() > 0:
                    sb.click(force=True)
                    time.sleep(4)
                else:
                    return False
            return True
        return False
    except Exception as e:
        _log(f"搜索打开 {name} 失败: {e}")
    return False


def open_friend_chat(page: Page, friend_name: str) -> bool:
    # 1) 快速路径：get_by_text（昵称连续时可命中）
    contact = page.get_by_text(friend_name, exact=False).first
    if contact.count() > 0:
        contact.click(force=True)
        time.sleep(random.uniform(2, 4))
        if page.locator('div[contenteditable="true"]').first.count() > 0:
            return True
    # 2) JS 遍历左栏 textContent（对字符拆分免疫）
    if _js_find_and_click(page, friend_name):
        if page.locator('div[contenteditable="true"]').first.count() > 0:
            return True
    # 3) 搜索兜底
    if search_and_open(page, friend_name):
        return True
    _log(f"[UI] 在会话列表里没找到 {friend_name}")
    return False


# ---------- 消息读取（文字 + 图片截图 + 视频文案） ----------

def _element_png_b64(el) -> str | None:
    """把一个元素截图成 PNG，返回 base64（失败返回 None）"""
    try:
        buf = el.screenshot(timeout=5000)
        img = Image.open(io.BytesIO(buf)).convert("RGB")
        # 限制尺寸，避免 base64 过大
        max_w = 800
        if img.width > max_w:
            h = int(img.height * max_w / img.width)
            img = img.resize((max_w, h))
        out = io.BytesIO()
        img.save(out, format="PNG")
        return base64.b64encode(out.getvalue()).decode("ascii")
    except Exception:
        return None


# ============ 界面噪音过滤（导航/按钮/反爬注入串，不应被当成好友消息）============
UI_NOISE_TEXTS = {
    "发消息", "搜索", "更多", "表情", "发送", "返回", "消息",
    "进入全屏", "退出全屏", "直播加载中", "抖音聊天", "联系人", "聊天",
    "视频通话", "语音通话", "位置", "红包", "表情包", "添加表情",
}

def _is_noise_text(txt: str) -> bool:
    """判断一段文本是不是界面噪音（导航/按钮/反爬注入串），不应被当成好友消息。"""
    t = (txt or "").strip()
    if not t:
        return True
    if t in UI_NOISE_TEXTS:
        return True
    # 反爬注入的乱码串特征：无明显中文字、含一长串字母、整体很短
    has_cn = bool(re.search(r"[\u4e00-\u9fff]", t))
    if not has_cn and re.search(r"[A-Za-z]{5,}", t) and len(t) <= 24:
        return True
    return False


def read_recent_messages(page: Page, max_n: int = 30, with_images: bool = True) -> list[dict[str, Any]]:
    """
    返回消息列表，每条：
      { role: 'user'|'assistant', type: 'text'|'image'|'video',
        content: str, img_b64: Optional[str], raw: str }
    文字气泡用 get_by_text 抓取；图片/视频元素截图供多模态模型识别。
    """
    out: list[dict[str, Any]] = []

    # 1) 文字气泡（更稳定，优先）
    try:
        bubbles = page.locator('div[contenteditable="true"]').first  # 确保已进会话
    except Exception:
        pass
    # 用消息容器：douyin 聊天气泡多为带文本的可点击块
    text_nodes = page.get_by_text("", exact=False)
    n = text_nodes.count()
    seen_text: set[str] = set()
    for i in range(max(0, n - max_n * 3), n):
        node = text_nodes.nth(i)
        try:
            txt = (node.inner_text(timeout=1500) or "").strip()
        except Exception:
            continue
        if not txt or len(txt) > 400 or txt in seen_text:
            continue
        # 过滤掉界面噪音（导航/按钮/反爬注入串），避免被误判为好友消息
        if _is_noise_text(txt):
            continue
        seen_text.add(txt)
        cls = (node.get_attribute("class") or "").lower()
        is_mine = any(k in cls for k in ("self", "me", "own", "right", "send", "outgoing"))
        out.append({"role": "assistant" if is_mine else "user", "type": "text",
                    "content": txt, "img_b64": None, "raw": txt})

    # 2) 图片/视频元素（截图给多模态模型看）
    if with_images:
        for sel in ['img[src*="png"]', 'img[src*="jpeg"]', 'img[src*="jpg"]',
                    'video', 'img[class*="image"]', 'img[class*="thumb"]']:
            elems = page.locator(sel)
            cnt = min(elems.count(), 6)
            for j in range(cnt):
                el = elems.nth(j)
                b64 = _element_png_b64(el)
                if b64:
                    tag = "video" if sel == "video" else "image"
                    out.append({"role": "user", "type": tag, "content": f"[{tag}]",
                                "img_b64": b64, "raw": f"[{tag}]"})

    # 按页面出现顺序近似排序：用每个元素的 bounding_box.y
    def _y(m):
        return 0
    # 不强制排序（文本已覆盖主要内容，图片作为补充上下文）
    return out[-max_n:]


def send_text(page: Page, text: str) -> bool:
    if not text.strip():
        return False
    try:
        editor = page.locator(SEL_MESSAGE_INPUT).first
        editor.wait_for(timeout=10000)
        editor.click()
        time.sleep(random.uniform(0.2, 0.6))
        chunk = random.randint(6, 12)
        for i in range(0, len(text), chunk):
            editor.type(text[i:i + chunk], delay=random.randint(30, 80))
        time.sleep(random.uniform(0.3, 0.7))
        sb = page.locator('button[aria-label*="发送" i], div[aria-label*="发送" i]').first
        if sb.count() > 0 and sb.is_enabled():
            sb.click()
        else:
            editor.press("Enter")
        time.sleep(random.uniform(0.8, 1.5))
        return True
    except Exception as e:
        _log(f"[发送] 失败: {e}")
        return False


# ===================== 拟人化延迟 =====================

def humanized_delay(emotion: str, msg_len: int) -> float:
    lo, hi = EMOTION_DELAY.get(emotion, (15, 70))
    base = random.uniform(lo, hi)
    # 消息越长，思考越久（每 20 字 +3~8s）
    base += (msg_len // 20) * random.uniform(3, 8)
    # 深夜/清晨更慢（像在玩手机偶尔回）
    h = datetime.now().hour
    if h < 7 or h >= 23:
        base *= 1.4
    return min(base, 240)  # 上限 4 分钟


# ===================== 处理单个好友 =====================

def process_friend(page: Page, cfg: AppConfig, friend: FriendConfig, *, dry_run: bool) -> dict[str, Any]:
    result = {"friend": friend.name, "new": 0, "replied": False, "skipped": ""}
    if not friend.enabled:
        result["skipped"] = "disabled"; return result
    if not in_active_hours(friend.active_hours):
        result["skipped"] = f"outside({friend.active_hours})"; return result

    history = load_history(friend.name)
    last_reply = next((h.get("ts") for h in reversed(history) if h.get("role") == "assistant"), 0)
    if last_reply:
        gap = time.time() - float(last_reply)
        if gap < friend.min_reply_interval_seconds:
            result["skipped"] = f"min_interval({int(gap)}s<{friend.min_reply_interval_seconds}s)"
            return result

    if not open_friend_chat(page, friend.name):
        result["skipped"] = "chat_open_failed"; return result

    msgs = read_recent_messages(page, with_images=friend.enable_vision)
    if not msgs:
        result["skipped"] = "empty_chat"; return result
    # 找最近一条"我发的"，其后的对方消息即新消息
    last_mine = -1
    for i, m in enumerate(msgs):
        if m["role"] == "assistant":
            last_mine = i
    incoming = [m for m in msgs[last_mine + 1:] if m["role"] == "user"]
    # 额外保险：若整段最后一条仍是我发的，说明对方尚未回复 / 没分享 -> 不回、不调 AI
    if msgs[-1]["role"] == "assistant":
        _log(f"[{friend.name}] 最后一条是我发的，对方无新消息，跳过（不调用 AI）")
        result["skipped"] = "last_is_mine(no_reply_from_friend)"; return result
    if not incoming:
        result["skipped"] = "no_new_incoming(对方无新消息)"; return result

    result["new"] = len(incoming)
    text_incoming = [m["content"] for m in incoming if m["type"] == "text" and m["content"].strip()]
    img_incoming = [m["img_b64"] for m in incoming if m.get("img_b64")]
    merged_text = "\n".join(text_incoming)
    _log(f"[{friend.name}] 收到 {len(incoming)} 条新消息(含图 {len(img_incoming)}): "
         + " | ".join(c[:30] for c in text_incoming))

    if random.random() > friend.reply_probability:
        result["skipped"] = "random_skip"; return result

    # 情绪识别
    emotion = "neutral"
    if cfg.emotion_on and friend.enable_emotion and merged_text:
        emotion = detect_emotion(cfg, merged_text)
        _log(f"[{friend.name}] 情绪: {EMOTION_CN.get(emotion, emotion)}")

    extra_system = ""
    if cfg.emotion_on:
        extra_system += "\n" + EMOTION_TONE.get(emotion, "")

    # 组成本轮要喂给模型的文本上下文
    context_lines = []
    for m in incoming:
        if m["type"] == "text":
            context_lines.append(f"对方：{m['content']}")
        else:
            context_lines.append(f"对方发来一张{m['type']}（需要看图片理解）")
    prompt_text = "\n".join(context_lines)
    if not prompt_text.strip():
        result["skipped"] = "empty"; return result

    # 多模态：把图片送给 vision 模型先"看懂"
    vision_desc = ""
    if friend.enable_vision and img_incoming:
        vision_desc = chat_vision(
            cfg, friend,
            "用一句话描述这张私信里的图片/截图在说什么（如果有文字/表情包，请读出文字）。",
            img_incoming, extra_system,
        ) or ""
        if vision_desc:
            _log(f"[{friend.name}] 图片理解: {vision_desc[:60]}")
            prompt_text += f"\n（对方图片内容：{vision_desc}）"

    reply = chat_text(cfg, friend, [{"role": "user", "content": prompt_text}], extra_system)
    if not reply:
        result["skipped"] = "ai_returned_empty"; return result

    # 长度裁剪 + 防暴露 AI 身份
    if len(reply) > friend.max_reply_chars:
        reply = reply[:friend.max_reply_chars].rstrip("，。！？,.!? ") + "…"
    reply = re.sub(r"作为\s*(一个|一款)?\s*AI|我是\s*AI|人工智能", "我", reply, flags=re.IGNORECASE)

    # 拟人化 emoji（按情绪加点表情文字）
    if emotion in ("happy", "teasing") and random.random() < 0.5:
        reply = reply.rstrip() + random.choice(["😄", "哈哈", "[捂脸]", "[旺柴]"])
    elif emotion in ("sad", "need_care") and random.random() < 0.4:
        reply = reply.rstrip() + random.choice(["🥺", "[抱抱]", "😢"])

    _log(f"[{friend.name}] AI 拟回复: {reply}")

    if dry_run:
        result["replied"] = "DRY-RUN"; return result

    # 拟人化延迟后再发
    delay = humanized_delay(emotion, len(merged_text))
    _log(f"[{friend.name}] 拟人化延迟 {delay:.0f}s 后发送")
    time.sleep(delay)

    if send_text(page, reply):
        now = time.time()
        for m in incoming:
            history.append({"role": "user", "content": m["content"], "ts": now})
        history.append({"role": "assistant", "content": reply, "ts": now,
                        "emotion": emotion})
        save_history(friend.name, history)
        result["replied"] = True
    else:
        result["skipped"] = "send_failed"
    return result


# ===================== 主入口 =====================

def run(*, dry_run: bool = False, only_friend: str | None = None) -> int:
    try:
        cfg = load_config()
    except Exception as e:
        _log(f"[启动] 配置读取失败: {e}"); return 2
    if not cfg.providers or all(not p.api_key for p in cfg.providers):
        _log("[启动] 没有任何 provider 配置了有效 api_key"); return 2

    targets = list(cfg.friends.values())
    if only_friend:
        targets = [f for f in targets if f.name == only_friend]
        if not targets:
            _log(f"[启动] 没找到好友 {only_friend}"); return 0

    with sync_playwright() as pw:
        try:
            ctx = build_context(pw)
        except Exception as e:
            _log(f"[启动] 浏览器初始化失败: {e}"); return 3
        page = ctx.new_page()
        try:
            goto_messages(page)
        except Exception as e:
            _log(f"[启动] 进入私信页失败: {e}"); ctx.close(); return 3

        for f in targets:
            try:
                r = process_friend(page, cfg, f, dry_run=dry_run)
                _log(f"[摘要] {r}")
                time.sleep(random.uniform(1.5, 3.5))
            except Exception as e:
                _log(f"[异常] 处理 {f.name}: {e}")
        ctx.close()
    _log("[本轮完成]")
    return 0


def show_stats() -> None:
    HISTORY_DIR.mkdir(parents=True, exist_ok=True)
    rows = []
    for fp in HISTORY_DIR.glob("*.json"):
        try:
            data = json.loads(fp.read_text(encoding="utf-8"))
        except Exception:
            continue
        n = len(data)
        last = data[-1].get("ts", 0) if n else 0
        last_str = datetime.fromtimestamp(last).strftime("%Y-%m-%d %H:%M") if last else "-"
        rows.append((fp.stem, n, last_str))
    rows.sort(key=lambda x: x[2], reverse=True)
    print(f"{'好友':<22} {'条数':>6}  {'最后一条'}")
    print("-" * 46)
    for name, n, last in rows:
        print(f"{name:<22} {n:>6}  {last}")
    if not rows:
        print("暂无历史")


def main() -> None:
    p = argparse.ArgumentParser(description="抖音私信 AI 自动回复（多模态版）")
    p.add_argument("--once", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--friend", type=str, default=None)
    p.add_argument("--stats", action="store_true")
    args = p.parse_args()
    if args.stats:
        show_stats(); return
    sys.exit(run(dry_run=args.dry_run, only_friend=args.friend))


if __name__ == "__main__":
    main()
