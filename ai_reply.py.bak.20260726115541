def build_context(pw: Playwright) -> BrowserContext:
    if not STATE_FILE.exists():
        raise FileNotFoundError("找不到 state.json，请先提取登录态。")
    state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    browser = pw.chromium.launch(
        headless=True,
        args=["--no-sandbox", "--disable-blink-features=AutomationControlled", "--disable-infobars", "--lang=zh-CN"],
    )
    return browser.new_context(
        storage_state=state, viewport={"width": 1280, "height": 800},
        locale="zh-CN",
        user_agent=("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                    "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"),
    )


def goto_messages(page: Page) -> None:
    if Stealth is not None:
        try:
            Stealth().apply_stealth_sync(page)
        except Exception as e:
            _log(f"[UI] stealth 应用失败(可忽略): {e}")
    page.goto(MESSAGES_URL, wait_until="domcontentloaded", timeout=60000)
    time.sleep(15)  # 与 cloud_streak.py 一致：等 React 渲染
